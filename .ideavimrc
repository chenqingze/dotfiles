" =============================================================================
" IdeaVim — 与 ~/.vim/vimrc 同结构、同键位
" =============================================================================

" ---------------------------------------------------------------------------
" bootstrap
" ---------------------------------------------------------------------------
let mapleader = " "
let maplocalleader = "\\"

set ideajoin
set idearefactormode=keep
set ideastatusicon=enabled

" ---------------------------------------------------------------------------
" editor options
" ---------------------------------------------------------------------------
set clipboard+=unnamed
set hlsearch ignorecase smartcase
set number
set scrolloff=5
set timeoutlen=400
set keep-english-in-normal
set keep-english-in-normal-and-restore-in-insert

" ---------------------------------------------------------------------------
" files — Project 工具窗（对标 netrw）
" <Space>e  侧栏    <Space>E  定位当前文件
" ---------------------------------------------------------------------------
map <leader>e <Action>(ActivateProjectToolWindow)
map <leader>E <Action>(SelectInProjectView)

" ---------------------------------------------------------------------------
" windows / buffers
" ---------------------------------------------------------------------------
" 导航
nnoremap <C-h> <C-w>h
nnoremap <C-j> <C-w>j
nnoremap <C-k> <C-w>k
nnoremap <C-l> <C-w>l
nnoremap <leader>w <C-w>w          " 下一个窗口
nnoremap <leader>W <C-w>W          " 上一个窗口

" 分屏
map <leader>sv <Action>(SplitVertically)
map <leader>sh <Action>(SplitHorizontally)
map <leader>se <Action>(EditSourceInNewWindow)   " 当前文件新窗口打开

" 取消分屏 / 只保留当前
map <leader>sq <Action>(Unsplit)                 " 取消所有分屏，保留所有标签
map <leader>so <Action>(UnsplitAll)              " 有时需要这个
" 或者用 Vim 原生：
" nnoremap <leader>so <C-w>o

" 关闭
map <leader>q  <Action>(CloseContent)
map <leader>bd <Action>(CloseContent)
map <leader>ba <Action>(CloseAllEditors)         " 关闭所有
map <leader>bo <Action>(CloseAllEditorsButActive) " 只留当前

" 标签页切换（你原来的 + 增强）
map <leader>bn <Action>(NextTab)
map <leader>bp <Action>(PreviousTab)
map <leader><Tab> <Action>(NextTab)
map <leader><S-Tab> <Action>(PreviousTab)

" 其他常用
map <leader>h  <Action>(HideAllWindows)          " 隐藏/恢复所有工具窗
map <leader>z  <Action>(ToggleDistractionFreeMode)
nnoremap <leader>/ :nohlsearch<CR>

" ---------------------------------------------------------------------------
" find — IDE 导航（对标 fzf）
" ---------------------------------------------------------------------------
map <leader>ff <Action>(GotoFile)
map <leader>fg <Action>(FindInPath)
map <leader>fb <Action>(Switcher)
map <leader>fh <Action>(RecentFiles)
map <leader>fl <Action>(Find)
map <leader>fc <Action>(GotoAction)
map <leader>fF <Action>(SearchEverywhere)

" ---------------------------------------------------------------------------
" motion — sneak（对标 vim-sneak；IDEA 插件里打开 sneak）
" ---------------------------------------------------------------------------
set sneak
let g:sneak#use_ic_scs = 1
nmap <leader>s <Plug>Sneak_s
nmap <leader>S <Plug>Sneak_S
xmap <leader>s <Plug>Sneak_s
xmap <leader>S <Plug>Sneak_S
omap <leader>s <Plug>Sneak_s
omap <leader>S <Plug>Sneak_S

" ---------------------------------------------------------------------------
" edit — surround / commentary / multiple-cursors
" cs/ds/ys  gc/gcc  <C-n>
" ---------------------------------------------------------------------------
set surround
set commentary
set multiple-cursors
set highlightedyank

" ---------------------------------------------------------------------------
" run / debug / git / terminal
" ---------------------------------------------------------------------------
map <leader>tt <Action>(ActivateTerminalToolWindow)
map <leader>td <Action>(Debug)
map <leader>d  <Action>(Debug)
map <leader>ru <Action>(Run)
map <leader>rs <Action>(Stop)
map <leader>b  <Action>(ToggleLineBreakpoint)
map <leader>ga <Action>(Annotate)
map <leader>gh <Action>(Vcs.ShowTabbedFileHistory)
"map <leader>z  <Action>(ToggleDistractionFreeMode)

" ---------------------------------------------------------------------------
" lsp — IntelliJ 原生（对标 yegappan/lsp）
" ---------------------------------------------------------------------------
map gd <Action>(GotoDeclaration)
map gD <Action>(GotoTypeDeclaration)
map gi <Action>(GotoImplementation)
map gy <Action>(GotoTypeDeclaration)
map gr <Action>(FindUsages)
map K  <Action>(QuickJavaDoc)
map <leader>rn <Action>(RenameElement)
map <leader>ca <Action>(ShowIntentionActions)
map <leader>lf <Action>(ReformatCode)
map <leader>o  <Action>(FileStructurePopup)
map [g <Action>(GotoPreviousError)
map ]g <Action>(GotoNextError)
map <leader>xx <Action>(ActivateProblemsViewToolWindow)
map <leader>a  <Action>(SwitchHeaderSource)
