# =============================================================================
# Global Git Ignore — ~/.config/git/ignore
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Operating System Files (操作系统临时文件)
# -----------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthru.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
*~
.trash/

# -----------------------------------------------------------------------------
# 2. Editors & IDEs (编辑器与 IDE 临时配置)
# -----------------------------------------------------------------------------
# Vim / Neovim
*.swp
*.swo
*.swn
*.swm
*.un~
.netrwhist
[._]*.s[a-v][a-z]
[._]*.sw[a-p]
Session.vim
.vim/undodir/

# JetBrains IDEs (IntelliJ IDEA, WebStorm, PyCharm, etc.)
.idea/
*.iml
*.iws
*.ipr
out/
.idea_modules/

# VS Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# -----------------------------------------------------------------------------
# 3. Shell & Terminal History (终端历史与缓存)
# -----------------------------------------------------------------------------
.zsh_history
.bash_history
.node_repl_history
.python_history
.lesshst
.sudo_as_admin_successful

# -----------------------------------------------------------------------------
# 4. Environment & Sensitive Data (环境变量与敏感密钥)
# -----------------------------------------------------------------------------
.env
.env.local
.env.*.local
*.pem
*.key
*.pub
*.p12
*.crt

# -----------------------------------------------------------------------------
# 5. Generic Archives & Logs (通用日志与压缩包)
# -----------------------------------------------------------------------------
*.log
*.tmp
*.bak
*.orig
*.rej
*.tar
*.gz
*.zip
*.7z
